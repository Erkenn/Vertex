  m_text: "\u0414\u0440\u043E\u043D - \u0440\u043E\u0431\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0435\u0442 \u043E\u0431\u043B\u0430\u0441\u0442\u044C
    \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0438\u0433\u0440\u043E\u043A\u0430.
    \u0415\u0441\u043B\u0438 \u0432\u044B \u043F\u043E\u043F\u0430\u0434\u0435\u0442\u0435\u0441\u044C
    \u043F\u043E\u0434 \u0435\u0433\u043E \u0432\u0437\u043E\u0440, \u0432\u0430\u043C
    \u043D\u0435 \u0441\u0434\u043E\u0431\u0440\u043E\u0432\u0430\u0442\u044C!\n\u0421\u043B\u0430\u0431\u043E\u0441\u0442\u044C:\n\u0415\u0433\u043E
    \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u043B\u043E\u043C\u0430\u0442\u044C,
    \u0438 \u043E\u043D \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F"
