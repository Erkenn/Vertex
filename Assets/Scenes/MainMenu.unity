  m_text: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:\n\u0421
    \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0432\u0437\u043B\u043E\u043C\u0430
    \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u0435\u0437\u0432\u0440\u0435\u0434\u0438\u0442\u044C
    \u0441\u043A\u0430\u043D\u0435\u0440\u043E\u0432, \u043E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u0438 \u0432\u044B\u0432\u043E\u0434\u0438\u0442 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F
    \u0441\u043A\u0430\u043D\u0435\u0440\u044B \u043D\u0430 \u0446\u0435\u043B\u044B\u0445
    5 \u0441\u0435\u043A\u0443\u043D\u0434!\n\u0429\u0438\u0442 \u043D\u0443\u0436\u0435\u043D
    \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u0441\u0442\u0440\u0430\u0436\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u0430\u0441 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u044E\u0442.
    \u0412\u0440\u0430\u0433 \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442, \u0435\u0441\u043B\u0438
    \u0443\u0434\u0430\u0440\u0438\u0442 \u0438\u0433\u0440\u043E\u043A\u0430 \u0441
    \u0449\u0438\u0442\u043E\u043C."
