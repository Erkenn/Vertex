      m_Calls: []
  m_text: "\u0421\u0442\u0440\u0430\u0436 - \u0432\u0440\u0430\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0430,
    \u0435\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0442. \u041E\u043D \u043D\u0430\u043C\u043D\u043E\u0433\u043E
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438\u0433\u0440\u043E\u043A\u0430.\n\u0421\u043B\u0430\u0431\u043E\u0441\u0442\u044C:\n\u041E\u043D
    \u043D\u0435 \u0431\u043E\u0438\u0442\u0441\u044F \u0432\u0437\u043B\u043E\u043C\u043E\u0432,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u0449\u0438\u0442\u043E\u043C \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043B\u044F
    \u043D\u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439"
